{
  "name": "dsh-session-manager",
  "version": "0.3.0",
  "private": true,
  "description": "会话与工作区清理：会话删除先进回收站（可恢复），工作区可移出或把文件夹移入回收站",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
